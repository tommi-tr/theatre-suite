{
  "name": "theatre-suite",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "diaframma:dev": "pnpm --filter diaframma tauri dev",
    "diaframma:build": "pnpm --filter diaframma tauri build",
    "launcher:dev": "pnpm --filter launcher tauri dev",
    "launcher:build": "pnpm --filter launcher tauri build",
    "bardo:dev": "pnpm --filter bardo tauri dev",
    "bardo:build": "pnpm --filter bardo tauri build",
    "bardo:test": "pnpm --filter bardo test",
    "cantinella:dev": "pnpm --filter cantinella tauri dev",
    "cantinella:build": "pnpm --filter cantinella tauri build",
    "cantinella:test": "pnpm --filter cantinella test"
  }
}
