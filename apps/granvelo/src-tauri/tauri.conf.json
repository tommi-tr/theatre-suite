{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Granvelo",
  "version": "0.4.0",
  "identifier": "it.theatresuite.granvelo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Granvelo",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Theatre Suite",
    "copyright": "© 2026 Theatre Suite",
    "category": "Entertainment",
    "shortDescription": "The lighting desk of a show: stage, lights, desk and memories",
    "longDescription": "Granvelo replaces the lighting desk: draw the stage with its lights, control them from a virtual desk and play the memories during the show through a USB-DMX cable. Everything stays on this computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "granvelo"
        ],
        "name": "Granvelo lighting",
        "description": "Granvelo lighting",
        "role": "Editor",
        "mimeType": "application/x-granvelo+json"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Italian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
