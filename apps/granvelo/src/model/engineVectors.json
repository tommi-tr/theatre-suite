{
  "about": "Shared vectors of the DMX engine: run by cargo test (src-tauri/src/dmx/core.rs, include_str!) and by vitest (src/lib/dmxSim.test.ts) so the native engine and the browser simulator stay identical. Each case is a list of steps at time t (seconds, never decreasing): a command ('do') or a check ('expect' = [channel 0-based, value] on the frame on the cable; 'under' = the same before the output master; 'fade' = whether a fade is running). Lists of [channel, value] are sparse: missing channels are 0. 'layout': 'all' = every channel is intensity.",
  "cases": [
    {
      "name": "fade up and down on time, the end is exactly the target",
      "steps": [
        { "t": 0, "do": "setUniverse", "values": [[1, 255]] },
        { "t": 0, "do": "fadeTo", "target": [[0, 255]], "transition": { "fadeIn": 2, "fadeOut": 2, "delay": 0, "moveInDark": false }, "layout": "all" },
        { "t": 0.5, "expect": [[0, 64], [1, 191]], "fade": true },
        { "t": 1, "expect": [[0, 128], [1, 128]] },
        { "t": 2.5, "expect": [[0, 255], [1, 0]], "fade": false }
      ]
    },
    {
      "name": "pause, resume, and a new fade while paused starts from the paused values and runs",
      "steps": [
        { "t": 10, "do": "fadeTo", "target": [[0, 200]], "transition": { "fadeIn": 4, "fadeOut": 4, "delay": 0, "moveInDark": false }, "layout": "all" },
        { "t": 11, "do": "pause" },
        { "t": 20, "expect": [[0, 50]], "fade": true },
        { "t": 20, "do": "resume" },
        { "t": 21, "expect": [[0, 100]] },
        { "t": 21, "do": "pause" },
        { "t": 25, "do": "fadeTo", "target": [], "transition": { "fadeIn": 1, "fadeOut": 1, "delay": 0, "moveInDark": false }, "layout": "all" },
        { "t": 25, "expect": [[0, 100]] },
        { "t": 25.5, "expect": [[0, 50]] },
        { "t": 26, "expect": [[0, 0]], "fade": false }
      ]
    },
    {
      "name": "set universe while paused ends the fade and jumps",
      "steps": [
        { "t": 0, "do": "fadeTo", "target": [[0, 200]], "transition": { "fadeIn": 2, "fadeOut": 2, "delay": 0, "moveInDark": false }, "layout": "all" },
        { "t": 1, "do": "pause" },
        { "t": 1, "do": "setUniverse", "values": [[1, 30]] },
        { "t": 1, "expect": [[0, 0], [1, 30]], "fade": false },
        { "t": 1, "do": "resume" },
        { "t": 5, "expect": [[0, 0], [1, 30]] }
      ]
    },
    {
      "name": "stop fade stays where it is",
      "steps": [
        { "t": 0, "do": "fadeTo", "target": [[0, 200]], "transition": { "fadeIn": 2, "fadeOut": 2, "delay": 0, "moveInDark": false }, "layout": "all" },
        { "t": 0.5, "do": "stopFade" },
        { "t": 9, "expect": [[0, 50]], "fade": false }
      ]
    },
    {
      "name": "blackout is reversible and the fade continues underneath",
      "steps": [
        { "t": 0, "do": "grandMaster", "level": 255, "mask": [0] },
        { "t": 0, "do": "setUniverse", "values": [[1, 77]] },
        { "t": 0, "do": "fadeTo", "target": [[0, 200], [1, 77]], "transition": { "fadeIn": 4, "fadeOut": 4, "delay": 0, "moveInDark": false }, "layout": "all" },
        { "t": 1, "do": "blackout", "on": true },
        { "t": 1, "expect": [[0, 0], [1, 77]], "under": [[0, 50], [1, 77]] },
        { "t": 3, "do": "blackout", "on": false },
        { "t": 3, "expect": [[0, 150], [1, 77]] }
      ]
    },
    {
      "name": "grand master only on the mask, with the engine's rounding",
      "steps": [
        { "t": 0, "do": "setUniverse", "values": [[0, 200], [1, 200], [2, 255], [3, 1]] },
        { "t": 0, "do": "grandMaster", "level": 128, "mask": [0, 2, 3] },
        { "t": 0, "expect": [[0, 100], [1, 200], [2, 128], [3, 1]] },
        { "t": 0, "do": "grandMaster", "level": 1 },
        { "t": 0, "expect": [[0, 1], [1, 200], [2, 1], [3, 0]] },
        { "t": 0, "do": "grandMaster", "level": 0 },
        { "t": 0, "expect": [[0, 0], [1, 200], [2, 0]] }
      ]
    },
    {
      "name": "fade to black combined with the grand master",
      "steps": [
        { "t": 0, "do": "setUniverse", "values": [[0, 200], [1, 255]] },
        { "t": 0, "do": "grandMaster", "level": 128, "mask": [0, 1] },
        { "t": 0, "do": "fadeToBlack", "seconds": 2 },
        { "t": 1, "expect": [[0, 50], [1, 64]] },
        { "t": 1.5, "expect": [[0, 25], [1, 32]] },
        { "t": 2, "expect": [[0, 0], [1, 0]] }
      ]
    },
    {
      "name": "fade to black reversed mid-ramp takes the time asked",
      "steps": [
        { "t": 0, "do": "setUniverse", "values": [[0, 200]] },
        { "t": 0, "do": "fadeToBlack", "seconds": 2 },
        { "t": 1, "do": "releaseBlack", "seconds": 2 },
        { "t": 1, "expect": [[0, 100]] },
        { "t": 2, "expect": [[0, 150]] },
        { "t": 3, "expect": [[0, 200]] },
        { "t": 3, "do": "fadeToBlack", "seconds": 0 },
        { "t": 3, "expect": [[0, 0]] }
      ]
    },
    {
      "name": "move in dark from a fade started in the middle of another one",
      "steps": [
        { "t": 0, "do": "setUniverse", "values": [[0, 255], [1, 50]] },
        { "t": 0, "do": "fadeTo", "target": [[1, 50]], "transition": { "fadeIn": 2, "fadeOut": 2, "delay": 0, "moveInDark": true }, "layout": { "intensity": [1, 0], "mover": [-1, 0], "moverIntensity": [[0]] } },
        { "t": 1, "expect": [[0, 128], [1, 50]] },
        { "t": 1, "do": "fadeTo", "target": [[1, 250]], "transition": { "fadeIn": 2, "fadeOut": 2, "delay": 0, "moveInDark": true }, "layout": { "intensity": [1, 0], "mover": [-1, 0], "moverIntensity": [[0]] } },
        { "t": 2, "expect": [[0, 64], [1, 50]] },
        { "t": 2.999, "expect": [[1, 50]] },
        { "t": 3, "expect": [[0, 0], [1, 250]] }
      ]
    },
    {
      "name": "malformed layouts: short arrays, mover out of range, moving head channel outside the universe",
      "steps": [
        { "t": 0, "do": "setUniverse", "values": [[0, 0], [1, 0], [2, 0]] },
        { "t": 0, "do": "fadeTo", "target": [[0, 200], [1, 200], [2, 200]], "transition": { "fadeIn": 2, "fadeOut": 2, "delay": 0, "moveInDark": true }, "layout": { "intensity": [0, 0], "mover": [7, 0], "moverIntensity": [[600]] } },
        { "t": 1, "expect": [[0, 100], [1, 100], [2, 100]] }
      ]
    },
    {
      "name": "a target longer than the universe is cut, a shorter one is padded with zeros",
      "steps": [
        { "t": 0, "do": "setUniverse", "values": [[0, 9], [511, 9]] },
        { "t": 0, "do": "fadeTo", "target": [[0, 100], [600, 255]], "transition": { "fadeIn": 0, "fadeOut": 0, "delay": 0, "moveInDark": false }, "layout": "all" },
        { "t": 0, "expect": [[0, 100], [511, 0]], "fade": false }
      ]
    },
    {
      "name": "the test pattern ignores blackout and grand master, and stopping it gives back the output",
      "steps": [
        { "t": 0, "do": "setUniverse", "values": [[5, 99]] },
        { "t": 0, "do": "blackout", "on": true },
        { "t": 0, "do": "grandMaster", "level": 0 },
        { "t": 0, "do": "test", "channels": 3, "level": 128 },
        { "t": 0.5, "expect": [[0, 128], [5, 0]] },
        { "t": 2, "expect": [[1, 128], [0, 0]] },
        { "t": 2, "do": "stopTest" },
        { "t": 2, "do": "blackout", "on": false },
        { "t": 2, "do": "grandMaster", "level": 255 },
        { "t": 2, "expect": [[5, 99]] },
        { "t": 2, "do": "test", "channels": 0, "level": 255 },
        { "t": 2.5, "expect": [[0, 255]] }
      ]
    }
  ]
}
