{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diaframma",
  "version": "0.2.1",
  "identifier": "it.theatresuite.diaframma",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Diaframma",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Theatre Suite",
    "copyright": "© 2026 Theatre Suite",
    "category": "Music",
    "shortDescription": "Sound cues and rehearsal audio for the theatre",
    "longDescription": "Diaframma plays sound cues during shows (GO with the space bar) and controls the audio players open on your computer during rehearsals.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "diaframma"
        ],
        "name": "Diaframma cue list",
        "description": "Diaframma cue list",
        "role": "Editor",
        "mimeType": "application/x-diaframma+json"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Italian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": [
      "sounds/*"
    ]
  }
}
