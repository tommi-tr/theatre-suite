{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cue",
  "version": "0.3.0",
  "identifier": "it.theatresuite.cue",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1425",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cue",
        "create": false,
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Theatre Suite",
    "copyright": "© 2026 Theatre Suite",
    "category": "Entertainment",
    "shortDescription": "The stage manager's digital prompt book: script, GOs and show control",
    "longDescription": "Cue is the one screen to look at during the show: the script with its GOs, and the command of lights, sound, images and video prepared in the other Theatre Suite apps. Everything stays on this computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "tcue"
        ],
        "name": "Spettacolo Cue",
        "description": "Spettacolo Cue",
        "role": "Editor",
        "mimeType": "application/x-theatre-cue+zip"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Italian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
